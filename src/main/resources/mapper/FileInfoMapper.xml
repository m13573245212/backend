<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.filemanagement.mapper.FileInfoMapper">

    <select id="getFiles" resultType="com.example.filemanagement.entity.FileInfo">
        SELECT id,
        file_name as fileName,
        file_path as filePath,
        create_time as createTime,
        update_time as updateTime
        FROM file_info
        <where>
            <if test="keyword !=null and keyword!='' ">
                file_name LIKE CONCAT('%', #{keyword}, '%')
            </if>
        </where>
        ORDER BY id
    </select>

    <select id="getFileById" resultType="com.example.filemanagement.entity.FileInfo">
        SELECT
            id,
            file_name as fileName,
            file_path as filePath,
            create_time as createTime,
            update_time as updateTime
        FROM file_info WHERE id = #{id}
    </select>

    <insert id="insertFile" parameterType="com.example.filemanagement.entity.FileInfo" useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO file_info (file_name, file_path,create_time) VALUES (#{fileName}, #{filePath},now())
    </insert>

    <update id="updateFile" parameterType="com.example.filemanagement.entity.FileInfo">
        UPDATE file_info SET file_name = #{fileName}, file_path = #{filePath},update_time=now() WHERE id = #{id}
    </update>

    <delete id="deleteFile" parameterType="Long">
        DELETE FROM file_info WHERE id = #{id}
    </delete>

</mapper>
